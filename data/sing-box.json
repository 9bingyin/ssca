{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "alidns",
        "server": "223.5.5.5",
        "server_port": 443,
        "path": "/dns-query"
      },
      {
        "type": "local",
        "tag": "local"
      }
    ],
    "final": "alidns",
    "strategy": "prefer_ipv4"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 2080
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": "alidns"
  },
  "experimental": {
    "cache_file": {
      "enabled": true
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9090"
    }
  }
}
